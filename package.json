{
  "name": "zk",
  "version": "1.0.0",
  "private": true,
  "description": "ZK \u2014 SAT preparation app (Expo mobile client, Next.js admin console, Supabase backend)",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace mobile",
    "dev:admin": "npm run dev --workspace admin",
    "dev:web": "npm run dev --workspace web",
    "build:shared": "npm run build --workspace @zk/shared",
    "build:admin": "npm run build --workspace admin",
    "build:web": "npm run build --workspace web",
    "typecheck": "npm run build:shared && npm run typecheck --workspace admin && npm run typecheck --workspace mobile && npm run typecheck --workspace web",
    "lint": "npm run lint --workspace admin --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "functions:serve": "supabase functions serve --env-file supabase/.env.local",
    "functions:deploy": "supabase functions deploy",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
