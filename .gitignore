# apps/mobile keeps its own standalone .git (no remote). Committing it here
# would store a gitlink pointing at an unclonable repo, so keep it out of this
# repository's index. To fold it in instead:
#   git rm --cached apps/mobile && rm -rf apps/mobile/.git && git add apps/mobile
