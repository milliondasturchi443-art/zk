# ---------------------------------------------------------------------------
# ZK — environment configuration (copy to `.env.local` / `.env` as needed)
# Never commit real secrets. Values below are placeholders only.
# ---------------------------------------------------------------------------

# --- Supabase project (used by apps/mobile, apps/admin and local tooling) ---
# Local development values come from `supabase status`:
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key printed by `supabase status`>
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# --- Server side only (NEVER ship these to a browser or a mobile bundle) ---
# Used by Edge Functions and by `scripts/bootstrap-admin.mjs`.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Shared secret required by the `admin-bootstrap` Edge Function.
# Generate with: openssl rand -hex 32
BOOTSTRAP_ADMIN_SECRET=replace-with-a-long-random-secret

# --- Optional ---
# Absolute URL used in password reset / email verification links.
APP_SITE_URL=http://localhost:3000
